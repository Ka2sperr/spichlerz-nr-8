# Supabase — server-side, used by the reservation Server Action (lib/supabase/server.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — public, only needed if a browser client is used (lib/supabase/client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — reservation confirmation emails (lib/email/resend.ts)
RESEND_API_KEY=
RESERVATION_NOTIFICATION_EMAIL=

# Public site URL — used for canonical/hreflang/OG/JSON-LD/sitemap (lib/seo/metadata.ts).
# Falls back to the production domain below when unset. Override per environment
# (e.g. http://localhost:3000 for local Lighthouse runs) or per client when reselling
# this template.
NEXT_PUBLIC_SITE_URL=https://spichlerznr8.pl
